# Copia este fichero a .env.

# Clave que deben mandar los clientes en la cabecera X-Token (obligatoria; p. ej. openssl rand -hex 24)
MOVER_MIX_TOKEN=

# Carpetas del anfitrión: Mix (destino; se escribe), tu biblioteca (solo lectura)
# y la carpeta de datos de Navidrome, con navidrome.db (solo lectura)
MIX=/ruta/a/tu/carpeta/Mix
MUSICA=/ruta/a/tu/musica
NAVIDROME_DATA=/ruta/a/navidrome/data

# Biblioteca de Navidrome (ruta dentro de SU contenedor) -> ruta aquí.
# Si Navidrome ve tu música en /music y tu Mix en /mix, no hace falta cambiarlo.
LIBRARY_ROOTS={"/music": "/music", "/mix": "/mix"}

# Ruta de Mix dentro del contenedor. Si la pones igual que en tu PC (y montas Mix
# ahí en docker-compose.yml), los .m3u generados valen tal cual en el PC.
MIX_PATH=/mix

# Opcional: base de music-fuzzy (musica_local.sqlite) para géneros, créditos y año del disco
# MFUZZ_DIR=/ruta/a/carpeta/con/musica_local

# Opcional: Last.fm (marca la canción como «loved» y, si se pide, como obsesión)
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_USERNAME=
LASTFM_PASSWORD=

# Opcional: Discogs para la fecha original de la canción
DISCOGS_TOKEN=

# Uid:gid con permiso de escritura en Mix
UID_GID=1000:1000
PUERTO=8786
